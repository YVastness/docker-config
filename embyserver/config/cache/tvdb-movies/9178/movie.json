Id":"9178","type":3,"image":"","sort":0,"isFeatured":true,"url":"282125-charlie","peopleType":"Actor","personName":"Charlie","personImgURL":""},{"id":12313207,"peopleId":311048,"movieId":"9178","type":1,"image":"","sort":6,"isFeatured":false,"url":"311048-richard-linklater","peopleType":"Director","personName":"Richard Linklater","personImgURL":""},{"id":12313208,"peopleId":311048,"movieId":"9178","type":2,"image":"","sort":6,"isFeatured":false,"url":"311048-richard-linklater","peopleType":"Writer","personName":"Richard Linklater","personImgURL":""},{"id":12313209,"peopleId":483845,"movieId":"9178","type":7,"image":"","sort":4,"isFeatured":false,"url":"483845-megan-ellison","peopleType":"Producer","personName":"Megan Ellison","personImgURL":""},{"id":12313210,"peopleId":311048,"movieId":"9178","type":7,"image":"","sort":6,"isFeatured":false,"url":"311048-richard-linklater","peopleType":"Producer","personName":"Richard Linklater","personImgURL":""},{"id":68905689,"name":"Sharon","peopleId":8205727,"movieId":"9178","type":3,"image":"","sort":7,"isFeatured":false,"url":"8205727-asjha-cooper","peopleType":"Actor","personName":"Asjha Cooper","personImgURL":"https://artworks.thetvdb.com/banners/v4/actor/8205727/photo/6165ac642d124.jpg"},{"id":69147016,"peopleId":8264388,"movieId":"9178","type":11,"image":"","sort":8,"isFeatured":false,"url":"8264388-sean-daniel","peopleType":"Executive Producer","personName":"Sean Daniel","personImgURL":""}],"budget":"10000000.00","boxOffice":"4600000.00","originalCountry":"usa","originalLanguage":"eng","studios":[{"id":4,"name":"Annapurna Pictures"}],"lists":[],"translations":{"nameTranslations":[{"name":"Todos queremos algo","language":"spa","IsPrimary":false},{"name":"Tutti vogliono qualcosa","tagline":"Il primo anno di college non si scorda mai","language":"ita","IsPrimary":false},{"name":"כולם רוצים את זה","language":"heb","IsPrimary":false},{"name":"에브리바디 원츠 썸!!","language":"kor","IsPrimary":false},{"name":"Каждому своё","language":"rus","IsPrimary":false},{"name":"各有少年时","language":"zho","IsPrimary":false},{"name":"Todos Querem o Mesmo","language":"por","IsPrimary":false},{"name":"Każdy by chciał!!","language":"pol","IsPrimary":false},{"name":"Everybody Wants Some!!","language":"eng","IsPrimary":true},{"name":"Jovens, Loucos e Mais Rebeldes","language":"pt","IsPrimary":false},{"name":"Everybody Wants Some !!","language":"fra","IsPrimary":false}],"overviewTranslations":[{"overview":"Texas, 1980. Jake sbarca al campus dove si appresta a cominciare il suo corso di studi. Lanciatore nella squadra di baseball dell'università ha una camera in una casa affollata di compagni che pensano principalmente a godersi la vita, seducendo fanciulle, bevendo birre e ballando agghindati nei club. Integrato molto presto nel gruppo di gioiosi conviventi, Jake si innamora di Beverly, una studentessa d'arte e spettacolo che sembra ricambiarlo. Tra una scazzottata e un allenamento, Jake e compagni approfitteranno della 'ricreazione'.\r\nTutti vogliono qualcosa comincia dove Boyhood finiva la sua corsa e ritorna sul 'debutto alla vita' di Richard Linklater all'università di Austin in Texas e nel settembre del 1980, l'anno in cui Reagan diventa presidente e la disco e il punk sono al loro apice, la permanente è ancora un must e il sesso protetto è ancora un divertente ossimoro. Ma l'intervallo è (quasi) finito e la campanella suona l'inizio delle lezioni per Jake e la sua generazione fracassona e baffuta. Ventitré anni dopo il regista texano ritorna sulle tracce del suo teen-movie La vita è un sogno, oggetto di culto negli States con cui questo campus movie di maschi alfa condivide il testosterone e la medesima coolness drammatica.\r\nSvolto in una sequenza fluida di quadri saturi di colori e di sonorità pop dove le ore sembrano dilatarsi all'infinito, Tutti vogliono qualcosa ribadisce l'ossessione di Linklater per il tempo, la fascinazione per la sua circolarità proustiana. E nel suo scorrere senza posa quello che coglie l'autore è il movimento stesso della vita da cui non pesca mai gli snodi simbolici ma i momenti complementari. Il suo cinema è una suite malinconica di attimi consueti mentre le epoche scorrono, le mode passano, le trame sfilano. Tutti vogliono qualcosa è un flusso di coscienza che restituisce immediatamente l'esperienza del tempo che scorre fuori dal nostro controllo e aggrappato a cose, parole, baleni marginali eppure pieni di una loro bellezza. Everybo","tagline":"Il primo anno di college non si scorda mai","language":"ita","IsPrimary":false},{"overview":"In Texas in the fall of 1980, college freshman Jake Bradford, a hotshot pitcher in high school, moves into an off-campus house with other members of the college baseball team. He meets several teammates, including his roommate Billy, who has been nicknamed \"Beuter\" because of his Deep Southern American English. He joins Finnegan, Roper, Dale, and Plummer cruising the campus by car, looking for women. Upperclassmen Roper, an unapologetic hound dog, and Finnegan, adopting a false feminist tone, both \"strike out\" with two attractive young women, but one of them, Beverly, says she likes Jake (\"the quiet guy in the back seat\"); he makes a note of her room number.","language":"eng","IsPrimary":true},{"overview":"Um grupo de jogadores de beisebol da faculdade embarca nas liberdades e responsabilidades da vida adulta sem supervisão, no Texas dos anos 1980.","language":"pt","IsPrimary":false},{"overview":"Suivez les péripéties d’un groupe d’amis qui découvre les libertés et les responsabilités de l’âge adulte. Et soyez prêts à passer le meilleur week-end de votre vie.","language":"fra","IsPrimary":false}],"aliases":"[Jovens, Loucos e Rebeldes 2]"},"companies":{"studio":[{"id":2051,"name":"Annapurna Pictures"}],"network":[],"production":[{"id":2051,"name":"Annapurna Pictures","slug":"annapurna-pictures","country":"usa","primaryCompanyType":3,"companyType":{"companyTypeId":3,"companyTypeName":"Production Company"},"parentCompany":{"relation":{}}}],"distributor":[],"special_effects":[]},"production_countries":[{"id":284380,"country":"usa","name":"United States of America"}],"inspirations":[],"spoken_languages":"[eng]","first_release":{"country":"global","date":"2016-03-30"}}